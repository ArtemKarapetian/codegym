[Unit]
Description=CodeGym Contest Platform
After=network.target

[Service]
Type=simple
User=codegym
Group=codegym
WorkingDirectory=/opt/codegym
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=DB_PATH=/opt/codegym/data/codegym.db
EnvironmentFile=/opt/codegym/.env
ExecStart=/usr/bin/node /opt/codegym/dist/server-bundle.mjs
Restart=on-failure
RestartSec=5

# Security
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/codegym/data /opt/codegym/backups

[Install]
WantedBy=multi-user.target
